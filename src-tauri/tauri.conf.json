{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Press",
  "version": "0.1.0",
  "identifier": "com.antonio.press",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost press: http://press.localhost; img-src 'self' press: http://press.localhost blob: data:; font-src 'self'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:"
    },
    "windows": [
      {
        "label": "main",
        "title": "Press",
        "width": 1200,
        "height": 800,
        "minWidth": 400,
        "minHeight": 400,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 14 }
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
